# Copy this to `.env` next to compose.yml and fill in the values.
# `docker compose up` picks .env up automatically.
#
# Without these set, the Discord button simply doesn't appear on
# /accounts/login/ — the rest of the app still works (read-only view +
# admin login).
#
# Register the OAuth app here:
#   https://discord.com/developers/applications
#
# Add both of these as authorized redirect URIs (the same OAuth app can
# serve dev and prod simultaneously):
#   http://localhost:5173/accounts/discord/login/callback/   (dev)
#   https://your-app.fly.dev/accounts/discord/login/callback/  (prod)

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
