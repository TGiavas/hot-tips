# Copy this to `.env` next to compose.yml and fill in the values.
# `docker compose up` picks .env up automatically.
#
# Without these set, the social login buttons simply don't appear on
# /accounts/login/ — the rest of the app still works (read-only view +
# admin login).
#
# Register the OAuth apps here:
#   Discord: https://discord.com/developers/applications
#   Google:  https://console.cloud.google.com/apis/credentials
#
# Add both of these as authorized redirect URIs in each provider:
#   http://localhost:5173/accounts/discord/login/callback/
#   http://localhost:5173/accounts/google/login/callback/
# (replace 'discord' / 'google' per provider — and add your fly.dev URLs
# too if you reuse the same OAuth apps for prod).

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
